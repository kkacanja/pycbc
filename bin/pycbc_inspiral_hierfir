#!/usr/bin/env python

"""
pycbc_inspiral_ratio: A pipeline-compatible script for inspiral analysis
using the Ratio Matched Filter method.

Two-stage hierarchical matched filtering:
  Pass 1 (coarse): Run at full sample rate but with high_frequency_cutoff=coarse_rate/2.
                   Uses the SAME stilde, PSD, and bank as Pass 2 — no decimation needed.
                   In the frequency domain, a lower sample rate is equivalent to
                   truncating the frequency series at the coarse Nyquist frequency.
  Pass 2 (fine):   Run at full sample rate over the full frequency range, but ONLY
                   within interest windows derived from Pass 1 trigger times.

Key design
----------
* Strain is read ONCE at the native (fine) sample rate.
* The coarse pass is implemented by setting high_frequency_cutoff = fine_rate/coarse_rate * nyquist
  on the coarse engine, which limits the matched filter to low frequencies only.
* Interest windows from Pass 1 are already in fine sample space (same stilde),
  so no sample-rate mapping is needed.
* block_f_cache is shared across the whole segment run, not rebuilt per window.
* FIR filter FFTs (prepare_filters) are computed once per coarse batch.
"""
import cProfile
import pstats
import io,os

import argparse
import logging
import numpy as np
import time

import pycbc
import pycbc.strain
import pycbc.psd
import pycbc.events
import pycbc.scheme
import pycbc.fft
import pycbc.inject
import pycbc.vetoes
from pycbc.types import complex64, float32, zeros, TimeSeries, FrequencySeries
from pycbc.conversions import mchirp_from_mass1_mass2
from pycbc.vetoes.sgchisq import SingleDetSGChisq
from pycbc.filter.matched_ratio_hier import RatioMatchedFilterControl
from pycbc.waveform.bank import RatioFilterBank

tstart = time.time()

def build_interest_windows(t_idxs, half_window, analyze_start, analyze_stop):
    """
    Expand trigger sample indices by half_window, merge overlapping intervals.
    Both coarse and fine passes use the same stilde, so t_idxs are already
    in fine sample space — no rate mapping needed.

    Returns list of (start, stop) int pairs.
    """
    windows = []
    for ct in np.sort(np.unique(t_idxs)):
        w0 = max(analyze_start, int(ct) - half_window)
        w1 = min(analyze_stop,  int(ct) + half_window + 1)
        if w0 >= w1:
            continue
        if windows and w0 <= windows[-1][1]:
            windows[-1] = (windows[-1][0], max(windows[-1][1], w1))
        else:
            windows.append((w0, w1))
    return windows


def compute_batch_chisq(ids_local, t_idxs, snrs, h_norm,
                        fine_indices, tstarts, stilde, bank, chisq_estimator,
                        engine, filters_f, ref_template, args):
    logging.info('starting chisq calculation')
    chisq_window_samp = int(args.chisq_window * stilde.sample_rate)
    max_iterations = args.chisq_iterations

    global_ids = ids_local
    gid_to_local = {gid: i for i, gid in enumerate(fine_indices)}
    try:
        local_batch_ids = np.array([gid_to_local[gid] for gid in global_ids])
    except KeyError as e:
        logging.error(f"Trigger Global ID {e} not found in current batch!")
        raise

    snr_amp = abs(snrs)
    num_trigs = len(snrs)
    chisq_vals = np.zeros(num_trigs, dtype=float32)
    chisq_dof_vals = np.zeros(num_trigs, dtype=np.int32) - 100
    assigned_mask = np.zeros(num_trigs, dtype=bool)

    _ref_weight = None

    cthresh = 0 if args.chisq_snr_threshold is None else args.chisq_snr_threshold
    if np.any(snr_amp > cthresh):
        sort_order = np.argsort(snr_amp)[::-1]
        iterations = 0
        for idx in sort_order:
            if iterations >= max_iterations:
                break
            if snr_amp[idx] < cthresh:
                break
            if assigned_mask[idx]:
                continue

            snrv = snrs[idx]
            t_idx = t_idxs[idx]
            target_global_id = global_ids[idx]
            tstart_local = tstarts[idx]

            rescale = bank.snr_rescale(target_global_id,
                                       method=args.template_normalization_method)
            snrvs = np.array([snrv], ndmin=1) / rescale
            tids  = np.array([t_idx], ndmin=1)

            if not args.fast_chisq:  # Slow chisq
                logging.info('regenerating template')
                ratio_filter = bank.get_fd_fir(target_global_id, len(stilde),
                                               delta_f=stilde.delta_f)
                logging.info('finished template regeneration')
                template = ratio_filter * ref_template
                template.params = ratio_filter.params
                template.f_lower = ref_template.f_lower

                corr = (template.conj() * stilde / stilde.psd
                        * (4 * stilde.delta_f / h_norm ** 0.5 / rescale))
                corr.resize((len(stilde) - 1) * 2)

                psd = stilde.psd.copy()
                psd[:] = 1
                template = template / stilde.psd ** 0.5
                template[:] = abs(template)
                template.params = ratio_filter.params
                template.f_lower = ref_template.f_lower

                logging.info('done')
                chi, dof = chisq_estimator.values(corr, snrvs, 1, psd,
                                                  tids, template)

            else:  # Fast chisq
                logging.info('regenerating chisq inputs')
                refine = 1
                df  = args.sample_rate / args.fir_length
                dfr = df / refine
                ratio = filters_f[local_batch_ids[idx]]

                if _ref_weight is None:
                    dec = int(dfr / stilde.delta_f)
                    w   = ref_template[::dec] / stilde.psd[::dec] ** 0.5
                    newf = np.arange(0, args.fir_length) * dfr
                    _ref_weight = np.interp(newf, w.sample_frequencies, w)

                template2 = FrequencySeries(ratio * _ref_weight,
                                            delta_f=dfr, dtype=stilde.dtype)
                template2[:] = abs(template2) / args.sample_rate
                template2.params = bank.table[target_global_id]
                template2.f_lower = ref_template.f_lower

                psd2 = FrequencySeries(
                    np.ones(len(ratio), dtype=np.float32), delta_f=dfr)

                import mkl_fft
                ref   = engine.ref_snr[tstart_local:tstart_local + args.fir_length]
                corr2 = (FrequencySeries(ratio * mkl_fft.fft(ref), delta_f=df)
                         / rescale / args.fir_length)
                corr2 = corr2.to_timeseries().to_frequencyseries(delta_f=dfr) / refine

                tids2 = tids - tstart_local
                logging.info('...done')
                chi, dof = chisq_estimator.values(corr2, snrvs, 1, psd2,
                                                  tids2, template2)

            window_mask  = (abs(t_idxs - t_idx) <= chisq_window_samp)
            update_mask  = window_mask & (~assigned_mask)
            chisq_vals[update_mask]     = chi
            chisq_dof_vals[update_mask] = dof
            assigned_mask[update_mask]  = True
            iterations += 1
            logging.info(f'... assigning {chi/dof} to {update_mask.sum()} '
                         f'triggers, peak SNR of {snr_amp[idx]}')

    unassigned = chisq_dof_vals < 0
    if unassigned.sum() > 0:
        chisq_dof_vals[unassigned] = 1
        chisq_vals[unassigned] = 0.0
        logging.info(f"  {unassigned.sum()} triggers below chisq threshold, "
                 f"setting chisq=0 dof=1")

    return chisq_vals, chisq_dof_vals


def get_args():
    parser = argparse.ArgumentParser(description=__doc__)

    pycbc.strain.insert_strain_option_group(parser)
    pycbc.strain.StrainSegments.insert_segment_option_group(parser)
    pycbc.psd.insert_psd_option_group(parser)
    pycbc.scheme.insert_processing_option_group(parser)
    pycbc.fft.insert_fft_option_group(parser)
    pycbc.inject.insert_injfilterrejector_option_group(parser)
    SingleDetSGChisq.insert_option_group(parser)

    hier = parser.add_argument_group("Hierarchical two-stage options")
    hier.add_argument('--coarse-sample-rate', type=int, default=2048,
                      help="Effective sample rate for Pass 1 (Hz). Sets the "
                           "high-frequency cutoff of the coarse matched filter "
                           "to coarse_rate/2. No decimation is performed — "
                           "both passes use the same strain and PSD. "
                           "Default: 2048 (single-stage mode).")
    hier.add_argument('--fine-sample-rate', type=int, default=2048,
                      help="Native sample rate (Hz). Strain is read at this "
                           "rate. Default: 2048.")
    hier.add_argument('--interest-window', type=int, default=8,
                      help="Half-width in samples for Pass-2 windows. "
                           "Default: 8.")
    hier.add_argument('--coarse-snr-threshold', type=float, default=4.0,
                      help="SNR threshold for Pass 1 trigger generation. "
                           "Should be lower than --snr-threshold. Default: 4.0.")

    parser.add_argument('--output', required=True,
                        help="Path to output HDF5 file.")
    parser.add_argument("--bank-file", type=str, required=True,
                        help="Path to the HDF5 Ratio Bank file.")
    parser.add_argument('--snr-threshold', type=float, default=5.5,
                        help="SNR threshold for Pass 2 trigger generation.")
    parser.add_argument("--newsnr-threshold", type=float, metavar='THRESHOLD',
                        help="Cut triggers with NewSNR less than THRESHOLD")
    parser.add_argument("--low-frequency-cutoff", type=float,
                        help="Low frequency cutoff for filtering (Hz).")

    group = parser.add_argument_group("Ratio Filter Options")
    group.add_argument('--high-frequency-cutoff', type=float,
                       help="Fine pass high frequency cutoff (defaults to Nyquist).")
    group.add_argument('--batch-size', type=int, default=64,
                       help="Number of filters per FFT batch.")
    group.add_argument('--fir-length', type=int, default=4096)

    parser.add_argument("--chisq-snr-threshold", type=float)
    parser.add_argument("--chisq-bins", default=0)
    parser.add_argument("--chisq-threshold", type=float, default=0)
    parser.add_argument("--chisq-window", type=float, default=1.0)
    parser.add_argument("--chisq-iterations", type=int, default=100)
    parser.add_argument("--chisq-delta", type=float, default=0)
    parser.add_argument("--cluster-window", type=float, default=0)
    parser.add_argument('--verbose', action='store_true')
    parser.add_argument("--keep-loudest-log-chirp-window", type=float)
    parser.add_argument("--keep-loudest-interval", type=float)
    parser.add_argument("--keep-loudest-num", type=int)
    parser.add_argument("--keep-loudest-stat", default="newsnr",
                        choices=pycbc.events.ranking.sngls_ranking_function_dict.keys())
    parser.add_argument("--template-normalization-method",
                        choices=('precalculated_sigma', 'mchirp'),
                        default='mchirp')
    parser.add_argument("--fast-chisq", action='store_true')

    return parser, parser.parse_args()


def main():
    parser, args = get_args()
    pycbc.init_logging(args.verbose)

    defaults = {
        'psdvar_segment':        None,
        'autochi_number_points': 0,
        'autochi_onesided':      False,
        'autochi_two_phase':     False,
        'autochi_max_valued_dof':False,
    }
    for k, v in defaults.items():
        if not hasattr(args, k):
            setattr(args, k, v)

    pycbc.strain.verify_strain_options(args, parser)
    pycbc.strain.StrainSegments.verify_segment_options(args, parser)
    pycbc.psd.verify_psd_options(args, parser)
    pycbc.fft.verify_fft_options(args, parser)

    fine_rate   = args.fine_sample_rate
    coarse_rate = args.coarse_sample_rate
    two_stage   = (fine_rate != coarse_rate)

    # Coarse high-frequency cutoff: Nyquist of the coarse rate.
    coarse_f_high = coarse_rate / 2.0

    if two_stage:
        logging.info(f"Two-stage: Pass 1 f_high={coarse_f_high} Hz, "
                     f"Pass 2 f_high={args.high_frequency_cutoff or fine_rate/2} Hz")
    else:
        logging.info(f"Single-stage @ {fine_rate} Hz")

    with pycbc.scheme.from_cli(args):

        inj_filter_rejector = pycbc.inject.InjFilterRejector.from_cli(args)

        # Read strain ONCE at the fine (native) rate.
        # Both passes will use this same strain — no decimation.
        logging.info(f"Reading strain @ {fine_rate} Hz ...")
        orig_rate        = args.sample_rate
        args.sample_rate = fine_rate
        gwstrain = pycbc.strain.from_cli(
            args, dyn_range_fac=pycbc.DYN_RANGE_FAC,
            inj_filter_rejector=inj_filter_rejector)
        args.sample_rate = orig_rate

        # Build segments once — shared between both passes
        orig_rate        = args.sample_rate
        args.sample_rate = fine_rate
        strain_segs = pycbc.strain.StrainSegments.from_cli(args, gwstrain)
        args.sample_rate = orig_rate

        flow        = args.low_frequency_cutoff
        flen        = strain_segs.freq_len
        delta_f     = strain_segs.delta_f

        # ------------------------------------------------------------------
        # Bank — one instance, used for both passes
        # ------------------------------------------------------------------
        logging.info("Initialising bank ...")
        bank = RatioFilterBank(
            args.bank_file, filter_length=flen,
            delta_f=delta_f, dtype=np.complex64)
        bank.template_thinning(inj_filter_rejector)

        # ------------------------------------------------------------------
        # Engines
        # Pass 1 (coarse): same delta_f, same bank, but f_high = coarse_rate/2
        # Pass 2 (fine):   full frequency range
        # ------------------------------------------------------------------
        engine_fine = RatioMatchedFilterControl(
            snr_threshold=args.snr_threshold,
            delta_f=delta_f,
            high_frequency_cutoff=args.high_frequency_cutoff,
            fir_fft_length=args.fir_length,
            batch_size=args.batch_size,
            tap_sample_rate=bank.sample_rate,
            engine_sample_rate=args.sample_rate)

        if two_stage:
            engine_coarse = RatioMatchedFilterControl(
                snr_threshold=args.coarse_snr_threshold,
                delta_f=delta_f,
                high_frequency_cutoff=coarse_f_high,
                fir_fft_length=args.fir_length,
                batch_size=args.batch_size,
                tap_sample_rate=bank.sample_rate,
                engine_sample_rate=args.coarse_sample_rate)
            # No stored_sample_rate correction needed — same stilde for both
        else:
            engine_coarse = engine_fine

        power_chisq = pycbc.vetoes.SingleDetPowerChisq(
            args.chisq_bins, args.chisq_snr_threshold)

        # ------------------------------------------------------------------
        # Event manager
        # ------------------------------------------------------------------
        out_types = {
            'time_index':    int,
            'snr':           complex64,
            'sigmasq':       float32,
            'chisq':         float32,
            'chisq_dof':     int,
            'bank_chisq':    float32,
            'bank_chisq_dof':int,
            'cont_chisq':    float32,
            'sg_chisq':      float32,
            'psd_var_val':   float32,
        }
        out_vals_ref = {k: None for k in out_types}
        names = sorted(out_vals_ref.keys())

        gating_info = getattr(gwstrain, 'gating_info', None)
        event_mgr = pycbc.events.EventManager(
            args, names, [out_types[n] for n in names],
            psd=None, gating_info=gating_info)

        cluster_window = int(args.cluster_window * gwstrain.sample_rate)

        # Build freq-domain segments — one set, shared by both passes
        logging.info("Building freq-domain segments ...")
        segs = strain_segs.fourier_segments()

        pycbc.psd.associate_psds_to_segments(
            args, segs, gwstrain, flen, delta_f, flow,
            dyn_range_factor=pycbc.DYN_RANGE_FAC, precision='single')

        if args.psdvar_segment is not None:
            logging.info("Calculating PSD variation")
            psd_var = pycbc.psd.calc_filt_psd_variation(
                gwstrain, args.psdvar_segment,
                args.psdvar_short_segment, args.psdvar_long_segment,
                args.psdvar_psd_duration, args.psdvar_psd_stride,
                args.psd_estimation, args.psdvar_low_freq, args.psdvar_high_freq)

        seg_ids_local   = []
        seg_t_idxs      = []
        seg_snr_sqs     = []
        seg_fine_mappings = []
        seg_h_norms     = []
        seg_coarse_ids  = []
        seg_chi         = []
        seg_chi_dof     = []

        tsetup = time.time() - tstart
        n_coarse_batches = len(bank.coarse_indices)

        # Main loop — Hierarchical Two-Stage Matching
        # ==================================================================
        for i, coarse_idx in enumerate(bank.coarse_indices):

            prof['n_batches'] += 1

            ref_tmpl           = bank.get_coarse_template(coarse_idx)
            taps, counts, fidx = bank.get_firs(coarse_idx)

            # ---- prepare_filters timing ----
            _t = time.perf_counter()
            filters_f_coarse, _ = engine_coarse.prepare_filters(taps, counts)
            filters_f_fine,   _ = engine_fine.prepare_filters(taps, counts)
            prof['t_prep_filters'] += time.perf_counter() - _t

            logging.info(f"  Ratio Batch {i+1}/{n_coarse_batches}, {len(taps)} FIR templates")

            for s_num in range(len(segs)):
                stilde = segs[s_num]
                seg_len = stilde.analyze.stop - stilde.analyze.start

                logging.info(f"Processing Segment {s_num}")

                # ---- Pass 1: Coarse Scan ----
                logging.info(f"   Seg {s_num} | Pass 1 (f<{coarse_f_high} Hz)")
                t1_p1 = time.time()
                ids_p1, t_p1, snrs_p1, h_norm_c, total_loops_c, loops_exec_c = \
                    engine_coarse.process_segment_coarse(
                        stilde, stilde.psd,
                        ref_tmpl, filters_f_coarse, counts,
                        np.arange(len(fidx)),
                        valid_slice=stilde.analyze,
                    )
                t2_p1 = time.time()
                
                t_pass1_seg = t2_p1 - t1_p1
                prof['t_pass1']       += t_pass1_seg
                prof['n_coarse_cands'] += len(ids_p1)
                prof['n_seg_samps']   += seg_len
                prof['n_segs']        += 1

                logging.info(f"     → {len(ids_p1)} coarse candidates [{t_pass1_seg:.3f}s]")
                
                # Base Style Performance Telemetry for Pass 1
                tperf_p1 = (stilde.analyze.stop - stilde.analyze.start) * stilde.delta_t / max(t2_p1 - t1_p1, 1e-9) * len(taps)
                logging.info(f"     batch perf (Pass 1): {tperf_p1} templates s/s")

                if len(ids_p1) == 0:
                    # Still need to count the loops that would have been done
                    # in Pass 2 so block_coverage denominator stays correct.
                    # process_segment_fine on an empty window set returns quickly;
                    # we use total_loops_c as a proxy for total_loops_f here.
                    prof['loops_total'] += total_loops_c
                    continue

                # Map time indices to native 2048 Hz space
                decimate = int(np.round(bank.sample_rate / args.coarse_sample_rate))
                fine_mapped_t_p1 = t_p1.copy() * decimate

                # ---- build_interest_windows timing ----
                _t = time.perf_counter()
                windows = build_interest_windows(
                    fine_mapped_t_p1,
                    args.interest_window,
                    stilde.analyze.start,
                    stilde.analyze.stop,
                )
                prof['t_build_windows'] += time.perf_counter() - _t
                prof['n_windows'] += len(windows)
                prof['n_window_samps']  += sum(e - s for s, e in windows)

                window_coverage_seg = (sum(e - s for s, e in windows) /
                                       max(seg_len, 1))
                logging.info(f"     → {len(windows)} interest windows, "
                             f"coverage {window_coverage_seg*100:.2f}% of segment")

                # ---- Pass 2: Fine Sweep ----
                logging.info(f"   Seg {s_num} | Pass 2 (full freq, {len(windows)} windows)")
                t1_p2 = time.time()
                ids_local, t_idxs, snrs, h_norm_f, total_loops_f, loops_exec_f = \
                    engine_fine.process_segment_fine(
                        stilde, stilde.psd,
                        ref_tmpl, filters_f_fine, counts,
                        fidx, windows=windows
                    )
                t2_p2 = time.time()
                
                t_pass2_seg = t2_p2 - t1_p2
                prof['t_pass2']       += t_pass2_seg
                prof['n_fine_triggers'] += len(ids_local)
                prof['loops_exec']    += loops_exec_f
                prof['loops_total']   += total_loops_f

                block_coverage_seg = loops_exec_f / max(total_loops_f, 1)
                logging.info(f"     → {len(ids_local)} fine triggers "
                             f"[{t_pass2_seg:.3f}s]  "
                             f"block coverage {block_coverage_seg*100:.2f}%  "
                             f"speedup vs full sweep "
                             f"{1.0/max(block_coverage_seg,1e-9):.1f}x")

                # Per-segment Pass1 vs Pass2 time ratio diagnostic
                logging.info(f"     T_pass2/T_pass1 this seg: "
                             f"{t_pass2_seg/max(t_pass1_seg,1e-9):.3f}  "
                             f"(ideal ≈ {block_coverage_seg:.3f})")

                # Base Style Performance Telemetry for Pass 2 (Calculated before the chisq tracking step)
                tperf_p2 = (stilde.analyze.stop - stilde.analyze.start) * stilde.delta_t / max(t2_p2 - t1_p2, 1e-9) * len(taps)
                logging.info(f"     batch perf (Pass 2): {tperf_p2} templates s/s")

                if len(ids_local) == 0:
                    continue

                # ---- Chi-squared timing ----
                tstarts_local = np.full(len(ids_local), stilde.analyze.start)
                _t = time.perf_counter()
                chi, chi_dof = compute_batch_chisq(
                    ids_local, t_idxs, snrs, h_norm_f,
                    fidx, tstarts_local, stilde, bank,
                    power_chisq, engine_fine, filters_f_fine, ref_tmpl, args)
                t_chisq_seg = time.perf_counter() - _t
                prof['t_chisq']       += t_chisq_seg
                prof['n_chisq_iters'] += int((chi_dof > 0).sum())

                logging.info(f"   chisq: {(chi_dof > 0).sum()}/{len(chi_dof)} triggers "
                             f"have valid chisq [{t_chisq_seg:.3f}s]  "
                             f"T_chisq/T_pass2: "
                             f"{t_chisq_seg/max(t_pass2_seg,1e-9):.3f}")

                # ---- Final GPS alignment shift ----
                t_idxs += (-stilde.analyze.start + stilde.cumulative_index)

                # Store confirmed events
                seg_ids_local.append(ids_local)
                seg_t_idxs.append(t_idxs)
                seg_snr_sqs.append(snrs)
                seg_fine_mappings.append(fidx)
                seg_h_norms.append(h_norm_f)
                seg_coarse_ids.append(coarse_idx)
                seg_chi.append(chi)
                seg_chi_dof.append(chi_dof)


        # Print cProfile results
#        for name, pr in [("PASS1_COARSE", pr_pass1), ("PASS2_FINE", pr_pass2)]:
 #           print(f"\n{'='*60}")
  #          print(f" {name} PROFILE")
   #         print(f"{'='*60}")
    #        s = io.StringIO()
     #       ps = pstats.Stats(pr, stream=s).sort_stats('cumulative')
      #      ps.print_stats(20)
        #    print(s.getvalue())
       # pr_pass1.dump_stats("pass1.prof")
        #pr_pass2.dump_stats("pass2.prof")
####################################################################################################################################

        logging.info("Grouping triggers...")
        triggers_by_template = {}
        for k in range(len(seg_ids_local)):
            cid  = seg_coarse_ids[k]
            norm = seg_h_norms[k]
            for j, lid in enumerate(seg_ids_local[k]):
                gid = lid  # lid is already the global ID
                if gid not in triggers_by_template:
                    triggers_by_template[gid] = ([], [], [], [], [], [])
                rec = triggers_by_template[gid]
                rec[0].append(seg_snr_sqs[k][j])
                rec[1].append(seg_t_idxs[k][j])
                rec[2].append(norm)
                rec[3].append(cid)
                rec[4].append(seg_chi[k][j])
                rec[5].append(seg_chi_dof[k][j])

        mc_bank   = mchirp_from_mass1_mass2(bank.table['mass1'],
                                             bank.table['mass2'])
        mc_coarse = mchirp_from_mass1_mass2(
            bank.coarse_bank.table['mass1'],
            bank.coarse_bank.table['mass2'])

        for gid, (snr, time_list, norm, cid, chi, chi_dof) in \
                triggers_by_template.items():

            out_vals = out_vals_ref.copy()
            out_vals['time_index'] = np.array(time_list)

            snr_rescale     = bank.snr_rescale(gid,
                                 method=args.template_normalization_method)
            sigmasq_rescale = bank.sigma_rescale(gid,
                                 method=args.template_normalization_method) ** 2.0

            out_vals['snr']     = np.array(snr) / snr_rescale
            out_vals['sigmasq'] = np.ones(len(time_list)) * norm * sigmasq_rescale
            out_vals['chisq']   = chi
            out_vals['chisq_dof'] = chi_dof

#            logging.info(f"snr_rescale for gid {gid}: {snr_rescale:.4f}, "
 #               f"raw snr max: {np.max(np.abs(snr)):.4f}, "
  #              f"rescaled snr max: {np.max(np.abs(np.array(snr)/snr_rescale)):.4f}")
            if args.psdvar_short_segment is not None:
                out_vals['psd_var_val'] = pycbc.psd.find_trigger_value(
                    psd_var, out_vals['time_index'],
                    args.gps_start_time, args.sample_rate)

            dummy = zeros(len(time_list), dtype=float32)
            out_vals['bank_chisq']     = dummy
            out_vals['bank_chisq_dof'] = dummy
            out_vals['cont_chisq']     = dummy
            out_vals['sg_chisq']       = dummy

            event_mgr.new_template(tmplt=bank.table[gid])
            event_mgr.add_template_events(names, [out_vals[n] for n in names])

            if cluster_window > 0:
                event_mgr.cluster_template_events("time_index", "snr",
                                                  cluster_window)
            event_mgr.finalize_template_events()

    # Finalize
    tstop    = time.time()
    run_time = tstop - tstart
    event_mgr.save_performance(1, len(segs), len(bank), run_time, tsetup)
    logging.info("Consolidating and writing events...")
####################################################################################################################################

#    logging.info(f"gwstrain start_time: {gwstrain.start_time}")
 #   logging.info(f"strain_segs start_time: {strain_segs.start_time if hasattr(strain_segs, 'start_time') else 'N/A'}")
  #  logging.info(f"args.gps_start_time: {args.gps_start_time}")
   # logging.info(f"First seg cumulative_index: {segs[0].cumulative_index}")
    #logging.info(f"First seg delta_t: {segs[0].delta_t}")
    #logging.info(f"Implied GPS of first trigger sample: "
     #           f"{gwstrain.start_time + segs[0].cumulative_index * segs[0].delta_t}")
#    event_mgr.consolidate_events(args, gwstrain=strain_segs)
####################################################################################################################################

    event_mgr.consolidate_events(args, gwstrain=gwstrain)
    event_mgr.finalize_events()
    event_mgr.write_events(args.output)
    logging.info("Finished.")


if __name__ == "__main__":
    main()
